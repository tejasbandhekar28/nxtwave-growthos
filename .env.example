# Environment Variables (.env)

# ==========================================
# Supabase PostgreSQL Configuration
# ==========================================
# Obtain from your Supabase Dashboard -> Project Settings -> API
# Use ONLY the Project URL and Anon (Publishable) Key in Vite.
# NEVER use or expose the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Force Demo Mode ('true' or 'false')
VITE_FORCE_DEMO_MODE=false
